{
  "version": "1.0",
  "title": "Fragebogen: Benutzeroberfläche des DICOM-Viewers",
  "intro": "Vielen Dank für Ihre Teilnahme! Die Umfrage dauert ca. 5 Minuten. Ihre Angaben sind anonym und werden nur zur Verbesserung der Benutzeroberfläche verwendet. Pflichtfragen sind mit * markiert.",
  "submit": {
    "endpoint": "https://api.web3forms.com/submit",
    "accessKey": "abbf96ba-dee1-4d1c-9c0b-31bcbdbebf56",
    "subject": "Neue Antwort: Fragebogen DICOM-Viewer",
    "email": ""
  },
  "sections": [
    {
      "id": "profil",
      "title": "1. Zu Ihrer Person",
      "questions": [
        {
          "id": "rolle",
          "type": "text",
          "text": "Was ist Ihre berufliche Rolle?"
        },
        {
          "id": "erfahrung",
          "type": "single",
          "text": "Haben Sie bereits mit DICOM/DICOM-Viewern gearbeitet?",
          "required": true,
          "options": ["Ja", "Nein"]
        }
      ]
    },
    {
      "id": "layout",
      "title": "2. Layout und Navigation",
      "questions": [
        {
          "id": "layout_anpassung",
          "type": "single",
          "text": "Möchten Sie die Benutzeroberfläche individuell anpassen können?",
          "options": ["Ja", "Nein"]
        },
        {
          "id": "layout_probleme",
          "type": "text",
          "text": "Wie viel Zeit wären Sie bereit, in das Erlernen der neuen Anwendung zu investieren?"
        }
      ]
    },
    {
      "id": "werkzeuge",
      "title": "3. Werkzeuge und Bedienung",
      "questions": [
        {
          "id": "stuerung",
          "type": "single",
          "text": "Wie wichtig sind Ihnen Tastenkürzel und Mausgesten?",
          "options": ["Sehr wichtig", "Eher wichtig", "Weniger wichtig", "Unwichtig"]
        },
        {
          "id": "betriebssysteme_browser",
          "type": "text",
          "text": "Welche Betriebssysteme oder Browser verwenden Sie?"
        },
        {
          "id": "erinnerungen",
          "type": "single",
          "text": "Soll die Anwendung Benachrichtigungen oder Erinnerungen anzeigen?",
          "options": ["Ja", "Nein"]
        },
        {
          "id": "falsche_eingabe",
          "type": "multi",
          "text": "Wie sollte die Anwendung auf falsche Eingaben reagieren?",
          "options": ["Fehlermeldung anzeigen", "Fehlerhafte Eingaben farblich markieren", "Hinweise zur Fehlerbehebung anzeigen", "Bestätigung vor dem Absenden verlangen"]
        },
        {
          "id": "wichtige_functionen",
          "type": "multi",
          "text": "Welche Funktionen würden Ihnen den Arbeitsalltag erleichtern?",
          "options": ["Automatische Datenspeicherung", "Tastenkombinationen (Shortcuts)", "Vorlagen für wiederkehrende Aufgaben", "Automatische Erinnerungen", "Suchverlauf", "Personalisierte Einstellungen"]
        }
      ]
    },
    {
      "id": "darstellung",
      "title": "4. Darstellung und Leistung",
      "questions": [
        {
          "id": "theme",
          "type": "single",
          "text": "Welches Farbschema bevorzugen Sie?",
          "options": ["Dunkel", "Hell", "Automatisch (Systemeinstellung)", "Egal"]
        },
        {
          "id": "lesbarkeit",
          "type": "scale",
          "text": "Texte, Symbole und Bildeinblendungen (z. B. Patientendaten) mussen gut lesbar sein.",
          "min": 1, "max": 5,
          "minLabel": "Stimme gar nicht zu",
          "maxLabel": "Stimme voll zu"
        },
        {
          "id": "ladezeit",
          "type": "scale",
          "text": "Ladezeiten und Reaktionsgeschwindigkeit sind für meine Arbeit wichtig.",
          "required": true,
          "min": 1, "max": 5,
          "minLabel": "Stimme gar nicht zu",
          "maxLabel": "Stimme voll zu"
        },
        {
          "id": "navigation",
          "type": "multi",
          "text": "Wie sollte die Navigation gestaltet sein?",
          "options": ["Klassisches Menü am oberen Bildschirmrand", "Seitenleiste (Sidebar)", "Navigationsleiste am unteren Bildschirmrand", "Navigation über Icons", "Keine Präferenz"]
        }
      ]
    },
    {
      "id": "gesamt",
      "title": "5. Sontige Fragen",
      "questions": [
        {
          "id": "datenschutz",
          "type": "text",
          "text": "Welche Anforderungen haben Sie an Datenschutz und Datensicherheit?"
        },
        {
          "id": "sonstiges",
          "type": "text",
          "text": "Weitere Anmerkungen (optional)"
        }
      ]
    }
  ]
}
